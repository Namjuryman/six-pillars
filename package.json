{
  "name": "six-pillars",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format:styles": "prettier --write src/styles*.css",
    "check:styles": "prettier --check src/styles*.css",
    "build": "npm run typecheck && node scripts/build-site.mjs isolated",
    "build:pages": "npm run typecheck && node scripts/build-site.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e:private": "node scripts/test-private-ui.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-markdown": "10.1.0",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.1.14",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "prettier": "3.6.2",
    "tailwindcss": "4.1.14",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.11"
  },
  "overrides": {
    "postcss": "8.5.23",
    "source-map-js": "1.2.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
